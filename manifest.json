{
  "manifest_version": 3,
  "name": "WebShield - Content & Popup Filter",
  "short_name": "WebShield",
  "version": "4.0.7",
  "author": "HuyTran1002",
  "description": "Công cụ hỗ trợ chặn cửa sổ bật lên tự động và quản lý quy tắc lọc mạng cục bộ.",
  "icons": {
    "16": "icon128.png",
    "32": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://accounts.firefox.com/*",
        "*://addons.mozilla.org/*",
        "*://*.mozilla.org/*",
        "*://accounts.google.com/*",
        "*://myaccount.google.com/*",
        "*://mail.google.com/*",
        "*://drive.google.com/*",
        "*://docs.google.com/*",
        "*://calendar.google.com/*",
        "*://meet.google.com/*",
        "*://chat.google.com/*",
        "*://chrome.google.com/*",
        "*://chromewebstore.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*",
        "*://appleid.apple.com/*",
        "*://github.com/*",
        "*://gitlab.com/*",
        "*://id.atlassian.com/*",
        "*://*.auth0.com/*",
        "*://*.paypal.com/*",
        "*://*.stripe.com/*",
        "*://*.canva.com/*",
        "*://canva.com/*",
        "*://*.figma.com/*",
        "*://*.notion.so/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://accounts.firefox.com/*",
        "*://addons.mozilla.org/*",
        "*://*.mozilla.org/*",
        "*://accounts.google.com/*",
        "*://myaccount.google.com/*",
        "*://mail.google.com/*",
        "*://drive.google.com/*",
        "*://docs.google.com/*",
        "*://calendar.google.com/*",
        "*://meet.google.com/*",
        "*://chat.google.com/*",
        "*://chrome.google.com/*",
        "*://chromewebstore.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*",
        "*://appleid.apple.com/*",
        "*://github.com/*",
        "*://gitlab.com/*",
        "*://id.atlassian.com/*",
        "*://*.auth0.com/*",
        "*://*.paypal.com/*",
        "*://*.stripe.com/*",
        "*://*.canva.com/*",
        "*://canva.com/*",
        "*://*.figma.com/*",
        "*://*.notion.so/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebShield",
    "default_icon": {
      "16": "icon128.png",
      "32": "icon128.png",
      "48": "icon128.png",
      "128": "icon128.png"
    }
  }
}